# Copy to .env and adjust. Every variable has a working dev default in
# docker-compose.yml, so the stack boots without a .env file at all.
# You only NEED to set the Stripe keys to test payments.

# --- Database / infra (defaults match docker-compose services) ---
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop_secret
POSTGRES_DB=shop

# --- JWT (change in anything resembling production) ---
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# --- Field-level encryption for PII at rest (64 hex chars = 32 bytes) ---
FIELD_ENCRYPTION_KEY=6f1d9c1e6a1b4f8e9d2c3b4a5f6e7d8c9b0a1f2e3d4c5b6a7f8e9d0c1b2a3f4e

# --- reCAPTCHA (defaults are Google's official public TEST keys: always pass) ---
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# --- Google OAuth (create at https://console.cloud.google.com, redirect URI:
#     https://localhost/api/v1/auth/google/callback) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe test mode (dashboard.stripe.com -> test keys).
#     Webhook secret comes from: stripe listen --forward-to localhost:3000/api/v1/payments/webhook ---
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
